{
  "name": "deep-read-summarize",
  "version": "0.6.2",
  "description": "DSH 精读插件：书籍精读、论文精读、视频总结、网页摘要 → 结构化 Markdown 读书笔记（YAML frontmatter，可放进 Obsidian / Logseq）。English: deep reading & summarization for DSH — books, papers, videos and web pages into structured Markdown notes.",
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./workflow": "./workflow.js",
    "./parsers": "./parsers/index.js",
    "./schemas": "./schemas/index.js",
    "./lib/cache": "./lib/cache.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "workflow.js",
    "parsers",
    "custom-parsers",
    "schemas",
    "lib",
    "skills",
    "scripts",
    "!scripts/release.js",
    "docs/RELEASE.md",
    "docs/ASR_BENCHMARK.md",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    ".env.example"
  ],
  "scripts": {
    "test": "node tests/run-tests.js",
    "lint": "node scripts/lint.js",
    "validate": "node tests/quick_validate.js && node scripts/security-check.js",
    "security": "node scripts/security-check.js",
    "test:node": "node --test",
    "release": "node scripts/release.js",
    "prepublishOnly": "node tests/run-tests.js && node --test && node scripts/lint.js && node scripts/security-check.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "lockedRuntime": "workflow tool semantics — see CHANGELOG.md",
    "minVersion": "0.1.0",
    "breakingPolicy": "re-validate with npm test after each DSH upgrade"
  },
  "keywords": [
    "dsh",
    "workflow",
    "summarization",
    "deep-read",
    "obsidian",
    "markdown",
    "llm",
    "subagent",
    "mapreduce",
    "parsers",
    "精读",
    "读书笔记",
    "论文精读",
    "视频总结"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PensiveFei/deep-read-summarize.git"
  },
  "dependencies": {
    "acorn": "8.19.0"
  }
}
